# LLM backend: ollama | llamacpp | lmstudio
LLM_BACKEND=ollama

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# llama.cpp server (OpenAI-compatible endpoint)
LLAMACPP_HOST=http://localhost:8080

# LM Studio (OpenAI-compatible endpoint)
LMSTUDIO_HOST=http://localhost:1234

# Seconds to wait for a single LLM response before giving up. Raise this if
# you see "Read timed out" errors — local models on CPU-only hardware can
# genuinely take several minutes per call.
LLM_TIMEOUT_SECONDS=600

# Web search
WEB_SEARCH_MAX_RESULTS=5

# File search roots (relative to user home unless absolute)
FILE_SEARCH_FOLDERS=Documents,Downloads,Desktop
